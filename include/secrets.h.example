#pragma once
// Copy this file to secrets.h (gitignored) and fill in real values.
// secrets.h itself must never be committed.

// ============================================================
// WiFi
// ============================================================
static const char* WIFI_SSID     = "your-wifi-ssid";
static const char* WIFI_PASSWORD = "your-wifi-password";

// ============================================================
// Telegram - message @BotFather to create a bot and get a token; message
// @userinfobot (or check https://api.telegram.org/bot<TOKEN>/getUpdates
// after messaging your bot once) to get your chat id.
// ============================================================
static const char* TELEGRAM_BOT_TOKEN = "0000000000:AAAA-your-bot-token-here";
static const char* TELEGRAM_CHAT_ID   = "000000000";

// ============================================================
// Per-camera credentials, matched by NAME (not position) to CAMERAS[] in
// config.h. Each `name` below must exactly match a CameraConfig.name entry
// there (case-sensitive, no extra whitespace) - that's how a camera gets its
// credentials at boot. Add or remove entries to match however many cameras
// you define in config.h; order doesn't matter since lookup is by name.
// ============================================================
struct CameraSecret {
  const char* name;
  const char* user;
  const char* pass;
};

static const CameraSecret CAMERA_SECRETS[] = {
  { "Front Gate Cam", "camera-username", "camera-password" },
  { "Vatilon H80",    "camera-username", "camera-password" },
};
static const size_t NUM_CAMERA_SECRETS = sizeof(CAMERA_SECRETS) / sizeof(CAMERA_SECRETS[0]);
