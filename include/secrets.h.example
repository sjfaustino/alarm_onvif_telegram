#pragma once
// Copy this file to secrets.h (gitignored) and fill in real values.
// secrets.h itself must never be committed.

// ============================================================
// WiFi
// ============================================================
static const char* WIFI_SSID     = "your-wifi-ssid";
static const char* WIFI_PASSWORD = "your-wifi-password";

// ============================================================
// Telegram - message @BotFather to create a bot and get a token; message
// @userinfobot (or check https://api.telegram.org/bot<TOKEN>/getUpdates
// after messaging your bot once) to get your chat id.
// ============================================================
static const char* TELEGRAM_BOT_TOKEN = "0000000000:AAAA-your-bot-token-here";
static const char* TELEGRAM_CHAT_ID   = "000000000";

// ============================================================
// Camera seed data - ONE-TIME migration only. Cameras are managed at
// runtime via the web UI (see webserver.h) and persisted in NVS, not here.
// This array is read exactly once, on the very first boot after NVS has no
// camera data yet, to seed the store - useful if you already have cameras
// tuned from a previous version of this project, or just want to
// pre-populate a few without using the web UI. After that first boot,
// CAMERA_SEED is never read again - leave it empty (as below) to just add
// every camera through the web UI instead.
// ============================================================
struct CameraSeed {
  const char* name;
  const char* deviceServiceUrl;
  bool        enabled;
  bool        useWSSecurity;
  bool        includeInitialTerminationTime;
  bool        includeReplyToAnonymous;
  const char* snapshotUriOverride;      // "" for none; {USER}/{PASS} substituted at runtime
  const char* preferredProfileKeyword;  // "" for none
  const char* user;
  const char* pass;
  const char* notes;                    // free-text context, shown in the web UI
};

static const CameraSeed CAMERA_SEED[] = {
  // { "Front Gate", "http://192.168.1.50/onvif/device_service", true, true, false, false,
  //   "", "", "camera-username", "camera-password", "" },
};
static const size_t NUM_CAMERA_SEED = sizeof(CAMERA_SEED) / sizeof(CAMERA_SEED[0]);
